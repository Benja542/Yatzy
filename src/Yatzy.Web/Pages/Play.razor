@page "/"
@implements IDisposable
@inject GameEngine Game
@inject OutcomeTreeSolver Solver

<PageTitle>Yatzy - spil med sandsynligheder</PageTitle>

<h1>Spil yatzy</h1>
<p class="lead">
    Seks terninger, tre kast pr. tur, 20 slag. Spillerne skiftes til at tage en tur, og
    under terningerne står sandsynligheden for at få <b>maks point</b> i hvert af de slag
    der er tilbage - regnet ud fra præcis de terninger du har markeret, både eksakt på
    udfaldstræet og estimeret med en simulering.
</p>

<div class="grid grid--play">
    <div>
        <div class="card">
            @if (Game.IsMultiplayer)
            {
                <div class="players">
                    @foreach (var player in Game.Players)
                    {
                        <div class="player @(ReferenceEquals(player, Game.CurrentPlayer) && !Game.IsGameOver ? "player--current" : null)">
                            <span class="player__name">@player.Name</span>
                            <span class="player__score">@player.Sheet.Total</span>
                        </div>
                    }
                </div>
            }

            @if (!Game.IsGameOver)
            {
            <div class="stat-row">
                @if (Game.IsMultiplayer)
                {
                    <div class="stat">
                        <div class="stat__label">Har tur</div>
                        <div class="stat__value">@Game.CurrentPlayer.Name</div>
                    </div>
                }
                <div class="stat">
                    <div class="stat__label">@(Game.IsMultiplayer ? "Runde" : "Tur")</div>
                    <div class="stat__value">@Game.Turn<span class="muted small"> / @YatzyRules.CategoryCount</span></div>
                </div>
                <div class="stat">
                    <div class="stat__label">Kast tilbage</div>
                    <div class="stat__value">@Game.RollsLeft<span class="muted small"> / @YatzyRules.RollsPerTurn</span></div>
                </div>
                <div class="stat">
                    <div class="stat__label">Score</div>
                    <div class="stat__value">@Game.Sheet.Total</div>
                </div>
            </div>
            }

            <div class="dice-row">
                @for (var i = 0; i < YatzyRules.DiceCount; i++)
                {
                    var index = i;
                    <Die Value="Game.Dice[index]"
                         Held="Game.Held[index]"
                         Clickable="Game.HasRolled && Game.RollsLeft > 0"
                         OnClick="() => Hold(index)" />
                }
            </div>

            <div class="toolbar">
                <button class="btn btn--primary" disabled="@(!Game.CanRoll)" @onclick="Roll">
                    @(Game.HasRolled ? "Kast om" : "Kast")
                </button>
                <button class="btn" @onclick="NewGame">Nyt spil</button>
                <button class="btn" @onclick="() => _showSetup = !_showSetup">
                    Spillere @(Game.IsMultiplayer ? $"({Game.Players.Count})" : string.Empty)
                </button>
                @if (Game.HasRolled && Game.RollsLeft > 0)
                {
                    <span class="muted small">Klik på en terning for at låse den.</span>
                }
            </div>
        </div>

        @if (_showSetup)
        {
            <div class="card">
                <h2>Spillere</h2>
                <p class="small muted">
                    Vælg hvor mange der er med, og hvad de hedder. Alle spiller på det samme
                    sæt terninger på skift - ét klik på "Kast" hører til den spiller der har tur.
                </p>
                <PlayerSetup InitialNames="PlayerNames" OnStart="StartWithPlayers" OnCancel="() => _showSetup = false" />
            </div>
        }

        @if (Game.IsGameOver)
        {
            <div class="card">
                <h2>@(Game.IsMultiplayer ? "Slutstilling" : "Spillet er slut")</h2>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Spiller</th>
                                <th class="num">Øverst</th>
                                <th class="num">Bonus</th>
                                <th class="num">Nederst</th>
                                <th class="num">I alt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var standing in Game.Standings)
                            {
                                <tr>
                                    <td class="num muted">@standing.Rank.</td>
                                    <td>
                                        @standing.Player.Name
                                        @if (standing.IsWinner && Game.IsMultiplayer)
                                        {
                                            <span class="badge badge--hit">🏆 vinder</span>
                                        }
                                    </td>
                                    <td class="num">@standing.Player.Sheet.UpperSum</td>
                                    <td class="num">@standing.Player.Sheet.Bonus</td>
                                    <td class="num">@standing.Player.Sheet.LowerSum</td>
                                    <td class="num"><strong>@standing.Total</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="toolbar" style="margin-top:.75rem">
                    <button class="btn btn--primary" @onclick="NewGame">Spil igen</button>
                </div>
            </div>
        }

        @if (Game.HasRolled && !Game.IsGameOver)
        {
            <div class="card">
                <h2>Forslag til @Game.CurrentPlayer.Name</h2>
                @if (Game.RollsLeft > 0)
                {
                    <p class="small muted">
                        Forslaget vælger de terninger der giver den højeste forventede score i turen -
                        samme udfoldning af udfaldstræet som sandsynlighederne, men med point i bladene.
                    </p>
                    <div class="toolbar">
                        <span>Behold</span>
                        <MiniDice Dice="SuggestedKeep" Kept="true" EmptyText="ingenting - kast alle om" />
                        <button class="btn btn--tiny" @onclick="UseSuggestedKeep">Brug</button>
                    </div>
                }
                else
                {
                    <div class="toolbar">
                        <span>Skriv hånden i</span>
                        <strong>@Categories.DanishName(SuggestedCategory)</strong>
                        <span class="badge">@Game.PotentialScore(SuggestedCategory) point</span>
                        <button class="btn btn--tiny" @onclick="() => Write(SuggestedCategory)">Skriv</button>
                    </div>
                }
            </div>
        }

        <div class="card">
            <h2>
                @if (Game.IsGameOver)
                {
                    <text>Sandsynligheder</text>
                }
                else
                {
                    <text>
                        Sandsynlighed for de slag
                        @(Game.IsMultiplayer ? Game.CurrentPlayer.Name + " har tilbage" : "du har tilbage")
                    </text>
                }
            </h2>

            @if (Game.IsGameOver)
            {
                <p class="muted">Alle blokke er fulde. Start et nyt spil for at se sandsynligheder igen.</p>
            }
            else
            {
                <p class="small muted">@ProbabilityIntro</p>

                @if (Game.HasRolled && Game.RollsLeft > 0)
                {
                    <div class="toolbar" style="margin-bottom:.6rem">
                        <span class="small">Du beholder</span>
                        <MiniDice Dice="HeldDice" Kept="true" EmptyText="ingen" />
                        <span class="small muted">@KeepHint</span>
                    </div>
                }

                <div class="toolbar" style="margin-bottom:.6rem">
                    <label class="field">
                        Simuleringer pr. slag
                        <select value="@_trials" @onchange="OnTrialsChanged">
                            <option value="5000">5.000</option>
                            <option value="25000">25.000</option>
                            <option value="100000">100.000</option>
                            <option value="500000">500.000</option>
                        </select>
                    </label>
                    <button class="btn" disabled="@_running" @onclick="() => RunMonteCarlo()">
                        @(_running ? "Simulerer ..." : "Kør Monte Carlo igen")
                    </button>
                    <label class="small">
                        <input type="checkbox" checked="@_auto" @onchange="OnAutoChanged" />
                        kør automatisk
                    </label>
                    <span class="small muted">
                        Maks point er sjældent, så små sandsynligheder kræver mange simuleringer
                        før estimatet bliver skarpt.
                    </span>
                </div>

                @if (_running)
                {
                    <div class="progress"><div style="width:@(_progress)%"></div></div>
                }

                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>Slag</th>
                                <th class="num" title="Point med de terninger der ligger nu">Nu</th>
                                <th class="num" title="Den højst mulige score i slaget">Maks</th>
                                <th class="num" title="Eksakt: udfaldstræet foldet sammen bagfra, med din markering låst fast i første omkast">
                                    Udfaldstræ
                                </th>
                                <th class="num" title="Estimat fra tilfældige kast med samme markering og samme mål, med 95 % konfidensinterval (Wilson)">
                                    Monte Carlo
                                </th>
                                <th class="num" title="Sandsynligheden hvis du i stedet beholdt det bedst mulige for netop dette slag">
                                    Bedst mulige
                                </th>
                                <th>Behold i stedet</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Rows)
                            {
                                <tr>
                                    <td title="@Categories.Description(row.Category)">
                                        @Categories.DanishName(row.Category)
                                        @if (row.AlreadyAchieved)
                                        {
                                            <span class="badge badge--hit" title="Maks point er allerede i hus">i hus</span>
                                        }
                                    </td>
                                    <td class="num">@row.CurrentScore</td>
                                    <td class="num muted">@row.MaxScore</td>
                                    <td class="num"><strong>@Format.SmartPercent(row.TreeProbability)</strong></td>
                                    <td class="num">
                                        @if (_monteCarlo.TryGetValue(row.Category, out var mc))
                                        {
                                            @Format.SmartPercent(mc.Estimate)
                                            <span class="muted small">± @Format.SmartPercent(mc.MarginOfError)</span>
                                        }
                                        else
                                        {
                                            <span class="muted">-</span>
                                        }
                                    </td>
                                    <td class="num muted">@Format.SmartPercent(row.BestProbability)</td>
                                    <td>
                                        @if (Game.RollsLeft > 0 && Game.HasRolled && row.LostByKeep > 1e-9)
                                        {
                                            <MiniDice Dice="row.BestKeep" Kept="true" EmptyText="kast alle om" />
                                            <button class="btn btn--tiny" @onclick="() => UseKeep(row.BestKeep)">Brug</button>
                                        }
                                        else if (Game.RollsLeft > 0 && Game.HasRolled)
                                        {
                                            <span class="muted small">din markering er den bedste</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="small muted" style="margin-top:.6rem">
                    "Udfaldstræ" og "Monte Carlo" svarer på præcis samme spørgsmål: beholder du dine
                    markerede terninger og spiller resten af turen så godt som muligt efter netop det
                    slag, hvor ofte ender du så med maks point? Den første er regnet eksakt, den anden
                    er et estimat - de skal give samme tal på nær simuleringens usikkerhed.
                    <a href="sandsynligheder">Se de analytiske formler</a>, eller
                    <a href="udfaldstrae">tegn træet op</a> for en enkelt hånd.
                </p>
            }
        </div>
    </div>

    <div>
        <div class="card">
            <h2>Blokken</h2>
            <ScoreBoard Game="Game" OnWrite="Write" />
        </div>
    </div>
</div>

@code {
    private readonly Dictionary<Category, MonteCarloResult> _monteCarlo = [];
    private readonly AutoPlayer _adviser = new();

    private IReadOnlyList<ProbabilityRow> _rows = [];
    private long _trials = 25_000;
    private bool _auto = true;
    private bool _running;
    private bool _showSetup;
    private int _progress;
    private int _runId;
    private bool _disposed;

    private IReadOnlyList<ProbabilityRow> Rows => _rows;

    private IReadOnlyList<string> PlayerNames => Game.Players.Select(player => player.Name).ToList();

    private int[] SuggestedKeep => Game.HasRolled && Game.RollsLeft > 0
        ? DiceCatalog.ToDice(DiceCatalog.Instance.Keep(_adviser.ChooseKeep(Game.StateId, Game.RollsLeft)))
        : [];

    private Category SuggestedCategory => Game.HasRolled
        ? _adviser.ChooseCategory(Game.Counts, Game.Sheet)
        : Category.Chance;

    protected override void OnInitialized() => Refresh(runMonteCarlo: false);

    private void Roll()
    {
        Game.Roll();
        Refresh();
    }

    /// <summary>Terningeøjnene for de terninger spilleren har markeret.</summary>
    private int[] HeldDice => Game.HasRolled
        ? Enumerable.Range(0, YatzyRules.DiceCount).Where(i => Game.Held[i]).Select(i => Game.Dice[i]).ToArray()
        : [];

    /// <summary>Tællevektoren for markeringen, eller null når den ikke betyder noget.</summary>
    private int[]? HeldCounts => Game.HasRolled && Game.RollsLeft > 0 ? YatzyRules.CountFaces(HeldDice) : null;

    private string KeepHint =>
        $"og kaster {YatzyRules.DiceCount - HeldDice.Length} om. " +
        "Klik på terningerne for at ændre markeringen.";

    private string ProbabilityIntro => Game.HasRolled
        ? $"Sandsynligheden for at ende med maks point i slaget, hvis du beholder de markerede " +
          $"terninger og bruger dine {Game.RollsLeft} resterende kast så godt som muligt."
        : "Før første kast: sandsynligheden for at få maks point i løbet af hele turen.";

    private void Hold(int index)
    {
        Game.ToggleHold(index);
        // Tabellen regnes ud fra markeringen, så den skal opdateres med det samme.
        Refresh();
    }

    private void UseKeep(IEnumerable<int> dice)
    {
        var counts = new int[YatzyRules.Faces];
        foreach (var die in dice)
        {
            counts[die - 1]++;
        }

        Game.ApplyKeep(counts);
        Refresh();
    }

    private void UseSuggestedKeep() => UseKeep(SuggestedKeep);

    private void NewGame()
    {
        Game.NewGame();
        _showSetup = false;
        Refresh();
    }

    private void StartWithPlayers(string[] names)
    {
        Game.NewGame(names);
        _showSetup = false;
        Refresh();
    }

    private void Write(Category category)
    {
        Game.Write(category);
        Refresh();
    }

    private void Refresh(bool runMonteCarlo = true)
    {
        _monteCarlo.Clear();

        if (Game.IsGameOver)
        {
            _rows = [];
            return;
        }

        // Blokken skifter ved hvert turskifte, så computerens forslag skal regnes forfra
        // for den spiller der nu har tur.
        _adviser.PlanTurn(Game.Sheet);

        _rows = ProbabilityReport.Build(
            Game.Sheet.Open,
            Game.HasRolled ? Game.Counts : null,
            HeldCounts,
            Game.RerollsLeft,
            ScoreGoal.MaxPoints);

        if (runMonteCarlo && _auto)
        {
            _ = RunMonteCarlo();
        }
    }

    /// <summary>
    /// Kører simuleringen i små portioner med et <c>await</c> imellem, så browseren
    /// kan nå at tegne fremdriften. Blazor WebAssembly kører på én tråd.
    /// </summary>
    private async Task RunMonteCarlo()
    {
        var runId = ++_runId;
        _running = true;
        _progress = 0;
        _monteCarlo.Clear();

        var counts = Game.HasRolled ? Game.Counts : null;
        var keep = HeldCounts;
        var rerolls = Game.HasRolled ? Game.RerollsLeft : Game.RerollsLeft - 1;
        var open = Game.Sheet.Open.ToList();
        const long chunk = 2_000;

        for (var i = 0; i < open.Count; i++)
        {
            var solution = Solver.Solve(open[i], ScoreGoal.MaxPoints);
            var estimator = new MonteCarloEstimator(solution, counts, rerolls, seed: null, firstKeep: keep);

            while (estimator.Trials < _trials)
            {
                estimator.Run(System.Math.Min(chunk, _trials - estimator.Trials));
                if (runId != _runId || _disposed)
                {
                    return;
                }

                _monteCarlo[open[i]] = estimator.Result;
                _progress = (int)(100.0 * (i + (double)estimator.Trials / _trials) / open.Count);
                StateHasChanged();
                await Task.Delay(1);
            }
        }

        if (runId == _runId)
        {
            _running = false;
            _progress = 100;
            StateHasChanged();
        }
    }

    private void OnTrialsChanged(ChangeEventArgs args)
    {
        if (long.TryParse(args.Value?.ToString(), out var value))
        {
            _trials = value;
            _ = RunMonteCarlo();
        }
    }

    private void OnAutoChanged(ChangeEventArgs args) => _auto = args.Value is true;

    public void Dispose()
    {
        _disposed = true;
        _runId++;
    }
}
